# ═══════════════════════════════════════════════════════════════════════════════
# RemitChain — application environment
# ═══════════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env      and fill in every value marked REQUIRED.
#
# On a production chain (NEXT_PUBLIC_CHAIN_ID=1990) the app REFUSES TO START
# without the required values. That is deliberate: a remittance service that
# cannot reach its database, encrypt its claim secrets or authenticate its
# payout worker should not be accepting money.
#
# Never commit the filled-in .env. It is covered by .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════


# ─── Chain ─────────────────────────────────────────────────────────────────────
# 1990 = QIE mainnet (production), 1983 = QIE testnet.
NEXT_PUBLIC_CHAIN_ID=1983
NEXT_PUBLIC_RPC_URL=https://rpc1testnet.qie.digital/

# Additional endpoints, comma-separated, tried in order when the primary fails.
# STRONGLY RECOMMENDED on mainnet: every read, send and claim goes through the
# chain RPC, so a single endpoint is a single point of failure for the product.
# Verify each one answers eth_blockNumber before relying on it.
#   NEXT_PUBLIC_RPC_URLS=https://rpc2mainnet.qie.digital/

# Public origin. REQUIRED on a production chain — claim links in emails are built
# from it, and without it they would point at a preview URL or at localhost.
NEXT_PUBLIC_APP_URL=https://your-domain.com


# ─── Relayer ───────────────────────────────────────────────────────────────────
# The relayer signs claim transactions and pays their gas. It is also the
# on-chain `recipient` of every claim, which means whoever holds this key can
# release any claimable escrow to that address.
#
#   - Keep it in a KMS/HSM in production, not in a plain environment variable.
#   - Fund it with gas only. It should never accumulate a balance.
#   - It MUST be a different wallet from the contract deployer key.
#
# REQUIRED on a production chain.
NEXT_PUBLIC_RELAYER_ADDRESS=0x...
RELAYER_PRIVATE_KEY=0x...


# ─── Data stores ───────────────────────────────────────────────────────────────
# Postgres holds the payout ledger. REQUIRED on a production chain — a payout
# that is not written down cannot be reconciled, retried or audited.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Upstash Redis backs distributed rate limiting and the per-sender prepare lock.
# REQUIRED on a production chain: without it, limits are per-instance only, so a
# fleet of N workers multiplies every limit by N.
UPSTASH_REDIS_REST_URL=https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=...


# ─── Secret material ───────────────────────────────────────────────────────────
# Both are PERMANENT. Rotating either one strands every in-flight transfer.
# Back them up somewhere you would back up a database encryption key.
#
# SECRETS_ENCRYPTION_KEY — AES-256-GCM key for claim secrets and OTPs at rest.
#   Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# PHONE_HASH_PEPPER — keys the on-chain phone commitment. With a public salt,
#   `recipientPhoneHash` is reversible by brute force over a national number
#   range, which leaks every recipient's phone number.
#   Generate:  node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
#
# REQUIRED on a production chain.
SECRETS_ENCRYPTION_KEY=
PHONE_HASH_PEPPER=


# ─── Scheduled jobs ────────────────────────────────────────────────────────────
# Authenticates /api/cron/*. Vercel Cron sends it as `Authorization: Bearer …`.
# Minimum 16 characters. REQUIRED on a production chain — the payout worker runs
# behind it, and an unauthenticated worker endpoint is a denial-of-service lever.
#   Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=


# ─── Recipient notifications ───────────────────────────────────────────────────
# How the recipient receives their claim link and 6-digit code.
#   email — Resend or Gmail SMTP (default)
#   sms   — Twilio
OTP_CHANNEL=email

# Option A: Resend (3,000/month free). Preferred for production.
RESEND_API_KEY=
RESEND_FROM="RemitChain <noreply@your-domain.com>"

# Option B: Gmail SMTP. Fine for low volume; rate-limited by Google.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option C: Twilio, when OTP_CHANNEL=sms.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=


# ═══════════════════════════════════════════════════════════════════════════════
# PAYOUT PROVIDERS — this is what actually moves money
# ═══════════════════════════════════════════════════════════════════════════════
#
# A corridor is OPEN only when its provider is fully configured here. A corridor
# with no configured provider cannot be selected on the send page and is
# rejected by the API. There is no stub fallback on a production chain.
#
# Currently implemented:
#   ae-in (UAE → India, UPI)  →  RazorpayX
#
# Not yet implemented — these corridors stay closed until a provider is written
# for them (see lib/payouts/providers/ and lib/corridors.ts):
#   us-mx (SPEI) · gb-ng (OPay) · sa-pk (JazzCash) · sg-bd (bKash)


# ─── RazorpayX (UPI payouts to India) ──────────────────────────────────────────
# Requires an ACTIVATED RazorpayX account, not just a Razorpay Payments account.
# All four values are needed before the corridor opens.
#
#   RAZORPAY_KEY_ID          rzp_live_… on mainnet. A rzp_test_… key is refused
#                            on a production chain at boot.
#   RAZORPAY_ACCOUNT_NUMBER  your RazorpayX virtual account number (the source
#                            of funds), NOT your bank account number.
#   RAZORPAY_WEBHOOK_SECRET  from Dashboard → Settings → Webhooks. Without it
#                            there is no verified settlement signal and payouts
#                            sit in PROCESSING until the reconciler times them out.
#
# Webhook URL to register:  https://your-domain.com/api/webhooks/razorpay
# Events to subscribe to:   payout.processed, payout.failed, payout.reversed,
#                           payout.updated, payout.rejected
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_NUMBER=
RAZORPAY_WEBHOOK_SECRET=


# ─── Compliance ────────────────────────────────────────────────────────────────
# SCREENING_PROVIDER selects the sanctions / PEP screening backend. It runs on
# BOTH parties in /api/transfers/prepare, before the quote and before any claim
# credential is minted.
#
# REQUIRED on a production chain. With none configured, screenTransfer returns
# BLOCK and every send is refused — an unscreened transfer is a compliance
# breach, and "allow by default because nothing is set up" is how those happen.
#
#   denylist — the operator-maintained screening_denylist table. Real and
#              useful for internal blocks and court orders, but it is NOT a
#              sanctions list: it only knows what you put in it.
#   none     — allow everything. Refused on a production chain.
#
# To add a real vendor (ComplyAdvantage, Chainalysis, Refinitiv, Sanctions.io),
# implement `ScreeningProvider` in lib/compliance/screening.ts and register it.
SCREENING_PROVIDER=denylist


# ─── Operations ────────────────────────────────────────────────────────────────
# Bearer token for /api/ops/* — the manual payout review queue. That endpoint
# can mark a payout as settled, so it is a money-moving surface. Minimum 32
# characters, and deliberately NOT the same value as CRON_SECRET.
#   Generate:  pnpm gen:secrets
OPS_API_TOKEN=


# ─── Identity verification ─────────────────────────────────────────────────────
# Until this is set, /api/kyc/upgrade refuses to raise anyone's tier on a
# production chain, and an unverified wallet cannot send at all (the on-chain
# tier-0 daily limit is zero).
#
# Wire your provider's signed decision into `verifyProviderDecision` in
# app/api/kyc/upgrade/route.ts before setting this.
KYC_PROVIDER=


# ─── Web Push (optional) ───────────────────────────────────────────────────────
#   Generate:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@your-domain.com


# ─── WalletConnect (optional) ──────────────────────────────────────────────────
NEXT_PUBLIC_WC_PROJECT_ID=


# ═══════════════════════════════════════════════════════════════════════════════
# ESCAPE HATCHES — every one of these defaults to the safe value.
# Do not set any of them on a production chain without reading what it does.
# ═══════════════════════════════════════════════════════════════════════════════

# Accept the pre-upgrade OTP scheme, whose on-chain commitment is brute-forceable
# from public data. Needed only during the cutover, so transfers created before
# the upgrade stay claimable for their 48-hour window.
#
# Takes an ISO-8601 TIMESTAMP, not a boolean, and stops having any effect once
# that moment passes. `true` is refused at boot on a production chain: the
# dangerous state is "someone forgot to remove it", and a runbook step saying
# "remember to remove it" is not a control.
#
# Anything more than 72h ahead is also refused — the claim window is 48h, so a
# longer window keeps a known-weak commitment accepted for no reason.
# ALLOW_LEGACY_OTP_SCHEME=2026-08-28T12:00:00Z

# ─── Exchange rates ────────────────────────────────────────────────────────────
# There are no hard-coded rates anywhere in the codebase, by design. Rates come
# from two independent free sources with failover, cached in Redis.
#
# FX_MAX_STALENESS_MINUTES is how old a cached rate may be and still back a
# binding quote. Beyond it the corridor closes and sends are refused (503)
# rather than quoted on data we cannot vouch for. Default 60.
# FX_MAX_STALENESS_MINUTES=60

# Simulated payout rail, so the full pipeline can be exercised without a
# provider account. REFUSED on a production chain — the app will not boot.
# ENABLE_SANDBOX_PAYOUTS=true

# Skip the "is it present" checks at build time. For CI/container builds only;
# missing values still surface as a 503 from /api/health at runtime.
# SKIP_ENV_VALIDATION=true
